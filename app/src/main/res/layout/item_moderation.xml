<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" style="@style/Widget.Raiz.Card"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_image_placeholder"
            android:contentDescription="@string/foto_del_producto" android:padding="14dp" android:src="@drawable/ic_image" app:tint="#C9B793"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mochila_wayuu" android:textAppearance="@style/TextAppearance.Raiz.Title" />
            <TextView android:id="@+id/tv_meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/finca_wayuu_sas_85_000" android:textAppearance="@style/TextAppearance.Raiz.Caption" />
            <TextView android:id="@+id/tv_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_amber" android:text="@string/pendiente" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:textAppearance="@style/TextAppearance.Raiz.Badge" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_approve" style="@style/Widget.Raiz.Button.Primary" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/aprobar" android:layout_weight="1" android:layout_marginEnd="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_reject" style="@style/Widget.Raiz.Button.Danger" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/rechazar" android:layout_weight="1" android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout></com.google.android.material.card.MaterialCardView>
